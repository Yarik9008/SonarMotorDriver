/* Тёмная тема SonarDebugGUI — «Sonar Ops Console».
   Палитра синхронизирована с sonar_gui/theme.py (COLORS). */

/* ---------- База ---------- */

QWidget {
    background-color: #0a0d13;              /* bg */
    color: #e4e7ee;                          /* text */
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow, QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: #0a0d13;
}

QToolTip {
    background-color: #161c27;               /* surface2 */
    color: #e4e7ee;
    border: 1px solid #33405a;               /* border2 */
    border-radius: 6px;
    padding: 4px 8px;
}

/* ---------- Шапка приложения ---------- */

#headerBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #141a26, stop:1 #0e1219);
    border-bottom: 1px solid #1f2735;        /* border */
}

/* ---------- Группы-панели ---------- */

QGroupBox {
    background-color: #10141c;               /* surface */
    border: 1px solid #1f2735;               /* border */
    border-radius: 10px;
    margin-top: 14px;
    padding: 8px 10px 8px 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #5aa6c2;                          /* accent */
    background: transparent;
    font-size: 11px;
    font-weight: 600;
}

/* ---------- Подписи ---------- */

QLabel { background: transparent; }
QLabel[dim="true"] { color: #8f9aad; }       /* text_dim */
QLabel[well="true"] {
    color: #8f9aad;
    background: #0b0f16;
    border: 1px solid #1f2735;
    border-radius: 6px;
    padding: 4px;
}

/* Чипы-статусы (после смены свойства chip вызывать style().unpolish/polish!) */
QLabel[chip="ok"] {
    background: rgba(95, 170, 130, 0.12);
    color: #5faa82;                          /* green */
    border: 1px solid rgba(95, 170, 130, 0.35);
    border-radius: 10px;
    padding: 3px 10px;
    font-weight: 600;
}
QLabel[chip="warn"] {
    background: rgba(201, 154, 91, 0.12);
    color: #c99a5b;                          /* amber */
    border: 1px solid rgba(201, 154, 91, 0.35);
    border-radius: 10px;
    padding: 3px 10px;
    font-weight: 600;
}
QLabel[chip="err"] {
    background: rgba(198, 106, 100, 0.12);
    color: #c66a64;                          /* danger */
    border: 1px solid rgba(198, 106, 100, 0.35);
    border-radius: 10px;
    padding: 3px 10px;
    font-weight: 600;
}
QLabel[chip="off"] {
    background: rgba(143, 154, 173, 0.08);
    color: #8f9aad;                          /* text_dim */
    border: 1px solid #2b3446;
    border-radius: 10px;
    padding: 3px 10px;
    font-weight: 600;
}

/* ---------- Кнопки ---------- */

/* Единый вторичный стиль кнопок для ОБЕИХ колонок: плоская заливка + рамка.
   Акцентный вариант — только через objectName (primaryButton). */
QPushButton {
    background: #1d2531;
    border: 1px solid #2f3a4c;
    border-radius: 7px;
    padding: 5px 12px;
    color: #e4e7ee;
}
QPushButton:hover {
    background: #242e3c;
    border-color: #33405a;                   /* border2 */
}
QPushButton:pressed {
    background: #141a24;
    border-color: #2b3446;
}
QPushButton:disabled {
    color: #5c6880;                          /* text_faint */
    background: #12161f;
    border-color: #1f2735;
}
QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3f7f95, stop:1 #2a5568);
    border-color: #5aa6c2;
    color: #eef6f9;
}

/* Заголовок сворачиваемой секции («▼ Мотор» и т.п.) — текст у левого края,
   а не по центру растянутой на всю ширину кнопки. */
QPushButton#sectionToggle {
    text-align: left;
    padding: 6px 10px;
}

QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3f7f95, stop:1 #2a5568);
    border: 1px solid #5aa6c2;               /* accent */
    color: #eef6f9;
    font-weight: 600;
}
QPushButton#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #488c9f, stop:1 #305e73);
}
QPushButton#primaryButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a5568, stop:1 #21444f);
}
QPushButton#primaryButton:disabled {
    background: #12161f;
    border-color: #1f2735;
    color: #5c6880;
}

/* ---------- Поля ввода ---------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #0b0f16;               /* well */
    border: 1px solid #1f2735;               /* border */
    border-radius: 7px;
    padding: 4px 8px;
    color: #e4e7ee;
    selection-background-color: #2a5568;     /* accent_dim */
    selection-color: #eef6f9;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #5aa6c2;                   /* accent */
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    color: #5c6880;
    border-color: #1a2230;
}

QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background-color: #10141c;               /* surface */
    border: 1px solid #33405a;               /* border2 */
    selection-background-color: #2a5568;
    selection-color: #eef6f9;
    color: #e4e7ee;
    outline: none;
}

/* Кнопки спин-боксов отключены программно (NoButtons в MainWindow):
   значения вводятся с клавиатуры и применяются кнопкой «✓». */

/* ---------- Чекбоксы / радиокнопки ---------- */

QCheckBox { spacing: 6px; background: transparent; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #2b3446;
    border-radius: 4px;
    background-color: #0b0f16;               /* well */
}
QCheckBox::indicator:hover { border-color: #33405a; }
QCheckBox::indicator:checked {
    background-color: #5aa6c2;               /* accent */
    border-color: #5aa6c2;
}

QRadioButton { spacing: 6px; background: transparent; }
QRadioButton::indicator {
    width: 15px; height: 15px;
    border: 1px solid #2b3446;
    border-radius: 8px;
    background-color: #0b0f16;               /* well */
}
QRadioButton::indicator:hover { border-color: #33405a; }
QRadioButton::indicator:checked {
    background-color: #5aa6c2;               /* accent */
    border: 4px solid #0b0f16;
}

/* ---------- Разделители / скроллбары / статусбар ---------- */

QSplitter::handle { background-color: #0a0d13; }          /* bg */
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical   { height: 3px; }
QSplitter::handle:hover { background-color: #33405a; }    /* border2 */

QScrollBar:vertical {
    background: #0b0f16;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2b3446;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #33405a; }
QScrollBar:horizontal {
    background: #0b0f16;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #2b3446;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #33405a; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QStatusBar {
    background-color: #0b0f16;               /* well */
    color: #8f9aad;                          /* text_dim */
    border-top: 1px solid #1f2735;           /* border */
}
QStatusBar::item { border: none; }
